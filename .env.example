# Telegram MTProto (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session string (generate with: npm run auth)
TELEGRAM_SESSION=
# Target group username (without @)
TARGET_GROUP=taxesnomadspain

# LLM Provider — set ONE of these
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=

# Embedding config
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004

# LLM model for classification/quality
LLM_MODEL=gemini-2.0-flash

# Database
DATABASE_PATH=./data/knowledge.db

# Logging
LOG_LEVEL=info
