{
  "name": "tg-knowledge-bot",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "seed": "tsx src/main.ts --mode=seed",
    "query": "tsx src/main.ts --mode=query",
    "analyze": "tsx src/main.ts --mode=analyze",
    "reputation": "tsx src/main.ts --mode=reputation",
    "auth": "tsx src/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "telegram": "^2.26.8",
    "ai": "^4.3.16",
    "@ai-sdk/openai": "^1.3.22",
    "@ai-sdk/google": "^1.2.18",
    "drizzle-orm": "^0.44.2",
    "better-sqlite3": "^11.9.1",
    "zod": "^3.25.28",
    "dotenv": "^16.5.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.19.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.19",
    "drizzle-kit": "^0.31.1"
  }
}
