{
  "name": "tg-knowledge-bot",
  "version": "0.2.0",
  "description": "Telegram group knowledge base builder — analyzes messages, deduplicates, scores by reputation, and builds a searchable KB",
  "author": "Roman Rolgin <rolginroman@users.noreply.github.com>",
  "contributors": [
    "Hermes Agent <hermes@nousresearch.com>"
  ],
  "license": "MIT",
  "repository": "github:kilogramirisok/tg-knowledge-bot",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsgo",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "seed": "tsx src/main.ts --mode=seed",
    "query": "tsx src/main.ts --mode=query",
    "analyze": "tsx src/main.ts --mode=analyze",
    "reputation": "tsx src/main.ts --mode=reputation",
    "auth": "tsx src/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.18",
    "@ai-sdk/openai": "^1.3.22",
    "ai": "^4.3.16",
    "better-sqlite3": "^11.9.1",
    "bullmq": "^5.76.7",
    "chalk": "^5.4.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "ioredis": "^5.10.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "telegram": "^2.26.8",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.19",
    "@typescript/native-preview": "^7.0.0-dev.20260511.1",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4"
  }
}
